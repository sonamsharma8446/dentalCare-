NODE_ENV=development
PORT=5000

# Local MongoDB, or paste your MongoDB Atlas connection string here
MONGODB_URI=mongodb://127.0.0.1:27017/dentalcare-kit

# Frontend address (used for the CORS allowlist)
CLIENT_URL=http://localhost:5173

# Secret used to sign login tokens. Must be at least 32 characters. Keep it private.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How many days a login lasts
JWT_EXPIRES_DAYS=7

# Failed login/register attempts allowed per IP every 15 minutes
AUTH_RATE_LIMIT=10

# First admin account, created by: npm run seed:admin
# Password needs at least 8 characters with a letter and a number.
# After seeding you can remove ADMIN_PASSWORD from this file.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
